TJEK_API_KEY=
DB_MODE=sqlite
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# MiniMax Token Plan key for heading normalization. Get from https://platform.minimax.io/user-center/basic-information.
MINIMAX_API_KEY_PERSONAL=
# Per-invocation cap for `pnpm normalize:llm`. The Cloud Function has a 300s
# hard timeout; subtract the budget for prior steps (scrape + per-call
# latency) and the 350ms post-call throttle, then size the LLM call budget:
#
#   300s total - ~30s scrape + N * (3s/call + 0.35s throttle) ≤ 270s
#
# Solving for N at 3.35s/call: N ≤ (270 - 30) / 3.35 ≈ 71.6, so N ≤ 71
# (integer N). The default of 60 leaves headroom for the daily-pass scrape
# variation, cold-start latency, and the per-pass sleep, and is well under
# the upper bound for the 06:30 Europe/Copenhagen weekly run. Set lower for
# tighter budgets (e.g. NORMALIZE_LLM_CAP=30 leaves ~30s of margin for
# downstream work).
# NORMALIZE_LLM_CAP=60
