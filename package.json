{
  "name": "tilbudstracker",
  "version": "0.1.0",
  "description": "Track Danish grocery offer prices from etilbudsavis.dk over time",
  "type": "module",
  "main": "dist/handler.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "functions-framework --target=handler --source=dist/handler.js",
    "start:cli": "node dist/cli.js",
    "gcp-build": "tsc",
    "scrape": "tsx src/cli.ts scrape",
    "stores": "tsx src/cli.ts stores",
    "track": "tsx src/cli.ts track",
    "untrack": "tsx src/cli.ts untrack",
    "stats": "tsx src/cli.ts stats",
    "gen-stores": "tsx src/gen-stores-md.ts",
    "apply-stores": "tsx src/apply-stores.ts",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
